{
  "name": "video-unique-studio-desktop",
  "version": "2.1.2",
  "description": "Video Unique Studio for Windows with native FFmpeg",
  "author": "Video Unique Studio",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.cjs",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.videounique.studio",
    "productName": "Video Unique Studio",
    "asar": true,
    "directories": {
      "output": "../desktop-dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "splash.html",
      "splash.js",
      "ffmpeg-manifest.json",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Video-Unique-Studio-Setup-${version}-x64.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
